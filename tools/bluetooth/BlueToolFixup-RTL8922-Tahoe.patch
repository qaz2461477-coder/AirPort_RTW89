+static const uint8_t kSkipEventMaskPage2FailureOriginal26_7[] =
+{
+    0x89, 0xDE,                   // mov  esi, ebx
+    0xE8, 0x3D, 0xE3, 0x0D, 0x00, // call <fail init step>
+    0x5B                          // pop  rbx
+};
